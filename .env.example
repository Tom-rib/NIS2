# ── Clés API pour le conseil multi-IA (skill conseil-multi-ia) ──
# Renseigne seulement les fournisseurs que tu possèdes. Le script ignore
# proprement ceux dont la clé est absente.

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (GPT) — https://platform.openai.com/
OPENAI_API_KEY=

# Google (Gemini) — https://aistudio.google.com/
GEMINI_API_KEY=

# ── Serveurs MCP (.mcp.json) — voir docs/guide-mcp.md ──
# ⚠️ Les serveurs MCP lisent l'environnement du SHELL, pas ce fichier .env.
# Exporte ces variables dans ton profil shell (~/.bashrc, ~/.zshrc) ou via direnv.

# GitHub MCP (PRs, issues, CI) — jeton « fine-grained » : https://github.com/settings/tokens
# GITHUB_PERSONAL_ACCESS_TOKEN=

# Postgres MCP (schéma, requêtes) — chaîne de connexion, utilisateur lecture seule si possible
# DATABASE_URL=postgresql://user:pass@localhost:5432/mabase

# Firecrawl MCP (scraping web) — https://firecrawl.dev/
# FIRECRAWL_API_KEY=

# Brave Search MCP (recherche web) — https://brave.com/search/api/
# BRAVE_API_KEY=

# (sentry et vercel s'authentifient en OAuth via /mcp ; figma passe par l'app desktop)

# ── Exemples de variables projet (à adapter) ──
# DATABASE_URL=
# PORT=3000
